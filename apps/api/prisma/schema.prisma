generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Incident {
  id        String   @id @default(uuid())
  reference String   @unique
  title     String
  location  String
  severity  String
  status    String   @default("New")
  longitude Float
  latitude  Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activities IncidentActivity[]
}

model IncidentActivity {
  id         String   @id @default(uuid())
  incidentId String
  action     String
  oldStatus  String?
  newStatus  String?
  createdAt  DateTime @default(now())

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId, createdAt])
}

enum NexusOperatorRole {
  ADMIN
  OPERATOR
}

enum NexusOperatorStatus {
  ACTIVE
  SUSPENDED
}

model OperatorAccount {
  id          String              @id @default(cuid())
  authUserId  String              @unique @db.Uuid
  email       String              @unique
  displayName String              @default("")
  role        NexusOperatorRole   @default(OPERATOR)
  status      NexusOperatorStatus @default(ACTIVE)

  compactCards          Boolean @default(false)
  highlightHighPriority Boolean @default(true)
  autoRefresh           Boolean @default(false)
  notificationsEnabled  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notificationReads OperatorNotificationRead[]
}

model OperatorNotificationRead {
  id         String   @id @default(cuid())
  operatorId String
  eventKey   String
  readAt     DateTime @default(now())

  operator OperatorAccount @relation(fields: [operatorId], references: [id], onDelete: Cascade)

  @@unique([operatorId, eventKey])
  @@index([operatorId])
}
