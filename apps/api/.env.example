# Supabase Postgres connection (Project Settings -> Database)
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase API (Project Settings -> API)
SUPABASE_URL="https://xxxx.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# Server-side only. Never put this in the web app.
SUPABASE_SECRET_KEY="sb_secret_..."

# Comma-separated list of allowed web origins (first one is used for invite links)
FRONTEND_URL="http://localhost:5173"
PORT=5000
